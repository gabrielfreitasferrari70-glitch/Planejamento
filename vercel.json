{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/cron-daily-summary?type=morning",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-daily-summary?type=night",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/import-schedule.py": {
      "maxDuration": 60
    },
    "api/send-whatsapp.js": {
      "maxDuration": 60
    },
    "api/cron-daily-summary.js": {
      "maxDuration": 60
    }
  }
}
